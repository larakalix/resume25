{
  "key": "article",
  "name": "Article",
  "fields": [
    {
      "key": "content_id",
      "label": "Original content ID",
      "type": "text",
      "required": true,
      "unique": true,
      "help_text": "Preserve this source identity. Lemonade assigns its own entry UUID separately."
    },
    {
      "key": "title",
      "label": "Title",
      "type": "text",
      "required": true
    },
    {
      "key": "slug",
      "label": "Slug",
      "type": "text",
      "required": true,
      "unique": true
    },
    {
      "key": "excerpt",
      "label": "Excerpt",
      "type": "long_text",
      "required": true
    },
    {
      "key": "content_html",
      "label": "Article HTML",
      "type": "long_text",
      "required": true,
      "help_text": "Preserved authored HTML, not Lemonade rich-text JSON. Sanitize remotely editable HTML in the delivery adapter."
    },
    {
      "key": "publication_date",
      "label": "Publication date",
      "type": "date",
      "required": true
    },
    {
      "key": "tags",
      "label": "Topics",
      "type": "choices",
      "required": true,
      "options": [
        "Comparison",
        "Features",
        "Frontend",
        "NextJS",
        "Nuxt",
        "Nuxt 4",
        "Performance",
        "Release",
        "SSR",
        "Vue"
      ]
    },
    {
      "key": "image_path",
      "label": "Image path",
      "type": "text",
      "required": false
    },
    {
      "key": "sort_order",
      "label": "Source order",
      "type": "number",
      "required": true
    }
  ]
}
