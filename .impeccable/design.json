      "css": ".ds-nav{display:flex;gap:1.75rem;font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:.875rem;}.ds-nav a{display:flex;align-items:center;min-height:44px;min-width:44px;justify-content:center;color:var(--color-paragraph,#64646c);text-decoration:none;border-bottom:2px solid transparent}.ds-nav a[aria-current]{color:var(--color-title,#1d1d1f);border-color:var(--color-accent,#0066cc)}.ds-nav a:hover{color:var(--color-accent,#0066cc)}.ds-nav a:focus-visible{outline:2px solid var(--color-accent,#0066cc);outline-offset:5px} @media(prefers-reduced-motion:reduce){.ds-nav{transition:none!important;transform:none!important}}"
