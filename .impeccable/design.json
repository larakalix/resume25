      "css": ".ds-project{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:.875rem;display:block;aspect-ratio:1.6;padding:1.25rem;border-radius:16px;background:var(--color-surface,#f5f5f7);overflow:hidden;color:var(--color-title,#1d1d1f);text-decoration:none}.ds-project-preview{display:grid;place-items:center;height:100%;border-radius:8px;box-shadow:0 12px 28px -12px #11182730;transition:transform 360ms cubic-bezier(.22,1,.36,1)}.ds-project:hover .ds-project-preview,.ds-project:focus-visible .ds-project-preview{transform:translateY(-4px) scale(1.015)}.ds-project:focus-visible{outline:2px solid var(--color-accent,#0066cc);outline-offset:5px} @media(prefers-reduced-motion:reduce){.ds-project{transition:none!important;transform:none!important}.ds-project-preview{transition:none!important;transform:none!important}}"
