      "html": "<button class=\"ds-street-control\" aria-label=\"Menu\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></button>",
      "css": ".ds-street-control{display:grid;place-items:center;min-width:46px;min-height:46px;border:1px solid var(--world-muted,#53677a);border-radius:14px;background:var(--world-paper,#fff9ed);color:var(--world-ink,#263e59);box-shadow:1px 3px 2px #34414925;cursor:pointer}.ds-street-control:hover{background:var(--world-soft,#e9f1ff);color:var(--world-blue,#2761bc)}.ds-street-control:focus-visible{outline:3px solid var(--world-blue,#2761bc);outline-offset:4px}.ds-street-control:active{transform:translateY(1px)}@media(max-width:767px){.ds-street-control{min-width:44px;min-height:44px}}"
    },
    {
      "name": "Street Context Prompt",
      "kind": "button",
