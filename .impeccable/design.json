      "css": ".ds-street-prompt{display:inline-flex;align-items:center;justify-content:center;gap:.65rem;min-height:44px;padding:.5rem .85rem;border:1px solid var(--world-line,#ced8db);border-radius:999px;background:var(--world-paper,#fff9ed);color:var(--world-ink,#263e59);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:.8125rem;cursor:pointer}.ds-street-prompt:hover{background:var(--world-soft,#e9f1ff)}.ds-street-prompt:focus-visible{outline:3px solid var(--world-blue,#2761bc);outline-offset:4px}"
    },
    {
      "name": "Street Reading Panel",
      "kind": "custom",
      "refersTo": "street-panel",
      "description": "One visible subject heading, separate Close and readable scrolling body.",
      "html": "<section class=\"ds-street-panel\" aria-label=\"Selected place\"><button class=\"ds-street-close\" aria-label=\"Close place\">\u00d7</button><div class=\"ds-street-body\"><h2>About me</h2><p>Source-backed profile content appears here.</p></div><button class=\"ds-street-return\">Back to the street <span>E / Esc</span></button></section>",
      "css": ".ds-street-panel{position:relative;width:min(390px,100%);display:flex;flex-direction:column;border:1px solid var(--world-line,#ced8db);border-radius:14px;background:var(--world-paper,#fff9ed);color:var(--world-ink,#263e59);box-shadow:0 6px 28px #24363d25;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-street-close{position:absolute;top:.65rem;right:.65rem;min-width:46px;min-height:46px;border:0;border-radius:9px;background:var(--world-paper,#fff9ed);color:var(--world-ink,#263e59);font-size:1.35rem;cursor:pointer}.ds-street-body{padding:1.3rem;overflow:auto}.ds-street-body h2{padding-right:2.6rem;font-family:\"Bricolage Grotesque\",sans-serif;font-size:clamp(1.8rem,3vw,2.5rem);font-weight:600;line-height:1.1;letter-spacing:-.025em}.ds-street-body p{font-size:.9375rem;line-height:1.75;color:var(--world-muted,#53677a)}.ds-street-return{display:flex;justify-content:space-between;gap:1rem;min-height:48px;padding:.6rem 1.3rem;border:0;border-top:1px solid var(--world-line,#ced8db);background:transparent;color:var(--world-blue,#2761bc);font-size:.8125rem;cursor:pointer}.ds-street-return span{font-size:.6875rem}.ds-street-close:hover,.ds-street-return:hover{background:var(--world-soft,#e9f1ff)}.ds-street-close:focus-visible,.ds-street-return:focus-visible{outline:3px solid var(--world-blue,#2761bc);outline-offset:4px}"
    },
    {
      "name": "Explorer Hat Select",
      "kind": "input",
      "refersTo": "world-hat-select",
      "description": "Self-contained HTML preview of the labelled Nuxt UI wardrobe treatment; production is USelect, Automatic plus five previews.",
      "html": "<div class=\"ds-world-preview ds-world-wardrobe\"><label id=\"ds-hat-label\">Explorer hat</label><button class=\"ds-world-hat-select\" type=\"button\" role=\"combobox\" aria-labelledby=\"ds-hat-label\" aria-haspopup=\"listbox\" aria-expanded=\"false\" aria-describedby=\"ds-hat-help\">Automatic \u00b7 seasonal<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"m7 10 5 5 5-5Z\"/></svg></button><p id=\"ds-hat-help\">Choose Automatic to follow the calendar.</p><p class=\"ds-world-hat-calendar\">June 1 \u00b7 Oct 25\u201331 \u00b7 Thanksgiving week \u00b7 Dec 20\u201326<br>Ivan\u2019s calendar \u00b7 Eastern Time</p></div>",
