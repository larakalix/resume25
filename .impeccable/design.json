      "css": ".ds-button-primary{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:.875rem;min-height:44px;padding:.625rem 1.25rem;border-radius:9999px;font-weight:500;background:var(--color-accent,#0066cc);color:var(--color-background,#fff);border:1px solid transparent;cursor:pointer;transition:background-color 160ms,transform 160ms} .ds-button-primary:hover{filter:brightness(.95)} .ds-button-primary:active{transform:scale(.97)} .ds-button-primary:focus-visible{outline:2px solid var(--color-accent,#0066cc);outline-offset:5px} @media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none!important;transform:none!important}}"
